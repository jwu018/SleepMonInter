# Night Night — example environment variables.
# This file is committed and contains PLACEHOLDERS ONLY. Never put real keys here.
#
# How to use:
#   Next.js only reads env files from its own folder, so copy the "web" section
#   below into web/.env.local and fill in real values (Phase 2, step 2).
#   web/.env.local is gitignored.

# ---------------------------------------------------------------
# web (Next.js) — Supabase Auth
# Find these in the Supabase dashboard: Project Settings → API Keys.
# (Supabase replaced the old "anon" / "service_role" keys with publishable / secret keys.)
# ---------------------------------------------------------------

# Public: NEXT_PUBLIC_ variables are bundled into browser code.
# Only the project URL and the publishable key (sb_publishable_...) are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# SERVER-ONLY, not used yet. A secret key (sb_secret_...) bypasses all security rules.
# Never prefix it with NEXT_PUBLIC_ and never use it in browser code.
# SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ---------------------------------------------------------------
# api (FastAPI) — Phase 3+, not used yet
# ---------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# CORS_ORIGINS=http://localhost:3000
