# Night Night — example environment variables.
# This file is committed and contains PLACEHOLDERS ONLY. Never put real keys here.
#
# How to use:
#   Next.js only reads env files from its own folder, so copy the "web" section
#   below into web/.env.local and fill in real values (Phase 2, step 2).
#   web/.env.local is gitignored.

# ---------------------------------------------------------------
# web (Next.js) — Supabase Auth
# Find these in the Supabase dashboard: Project Settings → API Keys.
# (Supabase replaced the old "anon" / "service_role" keys with publishable / secret keys.)
# ---------------------------------------------------------------

# Public: NEXT_PUBLIC_ variables are bundled into browser code.
# Only the project URL and the publishable key (sb_publishable_...) are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# SERVER-ONLY, not used yet. A secret key (sb_secret_...) bypasses all security rules.
# Never prefix it with NEXT_PUBLIC_ and never use it in browser code.
# SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Where the dashboard reads its data. Leave unset (or "static") to use the bundled files in
# web/data/. Set to "api" to read from the FastAPI backend, which must be running.
# SERVER-ONLY: none of these three may get a NEXT_PUBLIC_ prefix.
# DATA_SOURCE=api
# API_URL=http://localhost:8000
# API_SHARED_SECRET=the-same-long-random-string-as-in-api/.env

# ---------------------------------------------------------------
# api (FastAPI) — Phase 3
# Copy these lines into api/.env (gitignored) and fill in real values.
# ---------------------------------------------------------------

# Sites allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:3000

# The secret the Next.js server must send in the X-API-Key header. Leave it unset only on
# your own computer; set it (the same value as API_SHARED_SECRET above) anywhere public.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_SHARED_SECRET=a-long-random-string

# Folder for stored signal files, relative to api/ (gitignored).
# FILE_STORE_DIR=file_store

# SERVER-ONLY. The database password is in this string: never commit it, never print it,
# and never put it in a NEXT_PUBLIC_ variable. Needed from Phase 3 step 1.
# Find it in the Supabase dashboard: Connect -> Session pooler, then change the start
# from "postgresql://" to "postgresql+psycopg://".
# DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
